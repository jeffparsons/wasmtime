function %switch_int_clobber(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v3: i64):
    v2 = iconst.i64 42
    v100 = load.i64 v0+0
    v101 = load.i64 v0+8
    v102 = load.i64 v0+16
    v103 = load.i64 v0+24
    v104 = load.i64 v0+32
    v105 = load.i64 v0+40
    v106 = load.i64 v0+48
    v107 = load.i64 v0+56
    v108 = load.i64 v0+64
    v109 = load.i64 v0+72
    v110 = load.i64 v0+80
    v111 = load.i64 v0+88
    v112 = load.i64 v0+96
    v113 = load.i64 v0+104
    v114 = load.i64 v0+112
    v115 = load.i64 v0+120
    v116 = load.i64 v0+128
    v117 = load.i64 v0+136
    v118 = load.i64 v0+144
    v119 = load.i64 v0+152
    v120 = load.i64 v0+160
    v121 = load.i64 v0+168

    v299 = stack_switch v1, v3, v2

    v200 = iadd.i64 v299, v100
    v201 = iadd.i64 v200, v101
    v202 = iadd.i64 v201, v102
    v203 = iadd.i64 v202, v103
    v204 = iadd.i64 v203, v104
    v205 = iadd.i64 v204, v105
    v206 = iadd.i64 v205, v106
    v207 = iadd.i64 v206, v107
    v208 = iadd.i64 v207, v108
    v209 = iadd.i64 v208, v109
    v210 = iadd.i64 v209, v110
    v211 = iadd.i64 v210, v111
    v212 = iadd.i64 v211, v112
    v213 = iadd.i64 v212, v113
    v214 = iadd.i64 v213, v114
    v215 = iadd.i64 v214, v115
    v216 = iadd.i64 v215, v116
    v217 = iadd.i64 v216, v117
    v218 = iadd.i64 v217, v118
    v219 = iadd.i64 v218, v119
    v220 = iadd.i64 v219, v120
    v221 = iadd.i64 v220, v121

    return v221
}

